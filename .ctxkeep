# What of this tree becomes a node in the code graph.
#
# Generated by `make install` from the file types actually present
# here. This file REPLACES the default selection rather than adding
# to it, so deleting a line removes that file type from the graph.

# Python: the package and its tests
*.py

# Packaging and lint configuration
*.toml

# Markdown
*.md

# pre-commit, commitizen and the keenv config format
*.yaml

# Bash
*.sh

# Supported but absent from this tree: .bash, .c, .cc, .cjs, .cpp, .cs, .cxx,
#   .dockerfile, .epp, .erb, .go, .h, .hcl, .hpp, .htm, .html, .java, .js,
#   .json, .jsx, .kt, .markdown, .mjs, .mk, .php, .phtml, .pp, .rb, .rs,
#   .scala, .sql, .tf, .tfvars, .ts, .tsx, .yml
